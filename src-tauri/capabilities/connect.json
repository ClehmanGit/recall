{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "connect",
  "description": "Sign-in windows for chat apps: on the chat sites only, the reader script may call its four commands and nothing else.",
  "windows": [
    "connect-*"
  ],
  "remote": {
    "urls": [
      "https://claude.ai/*",
      "https://*.claude.ai/*",
      "https://gemini.google.com/*",
      "https://chatgpt.com/*"
    ]
  },
  "permissions": [
    "allow-connect-known",
    "allow-connect-ingest",
    "allow-connect-progress",
    "allow-connect-report"
  ]
}
