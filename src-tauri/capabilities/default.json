{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capabilities",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-status",
    "allow-search",
    "allow-recent-queries",
    "allow-clear-recent-queries",
    "allow-remove-recent-query",
    "allow-starred",
    "allow-recently-indexed",
    "allow-browse",
    "allow-item-chunks",
    "allow-set-star",
    "allow-exclude-item",
    "allow-unexclude",
    "allow-list-excluded",
    "allow-pick-folders",
    "allow-add-source",
    "allow-remove-source",
    "allow-set-source-enabled",
    "allow-resync-source",
    "allow-resync-all",
    "allow-get-rules",
    "allow-set-rules",
    "allow-preview-rules",
    "allow-set-platform-enabled",
    "allow-data-info",
    "allow-reset-index",
    "allow-send-feedback",
    "allow-open-item",
    "allow-reveal-item",
    "allow-connect-platform",
    "allow-sync-platform",
    "allow-disconnect-platform",
    "core:default"
  ]
