{
  "manifest_version": 3,
  "name": "Recall Bridge",
  "version": "2.0.0",
  "description": "Forwards your Claude, Gemini and ChatGPT conversations to the Recall desktop app on this machine. Nothing leaves your computer.",
  "permissions": ["alarms", "storage", "cookies"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "http://127.0.0.1:47617/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Recall Bridge" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
